<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_base">

    <ImageView
        android:id="@+id/imgSummaryBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_archive" />

    <View
        android:id="@+id/viewSummaryWash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/overlay_summary_wash" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="@dimen/status_pad"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_xl">

        <ImageView
            android:id="@+id/imgSummaryStamp"
            android:layout_width="@dimen/stamp_art"
            android:layout_height="@dimen/stamp_art"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/sprite_stamp"
            android:translationY="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtSummaryOverline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:letterSpacing="0.24"
            android:text="@string/summary_overline"
            android:textAppearance="@style/TextAppearance.App.Overline"
            app:layout_constraintEnd_toStartOf="@+id/imgSummaryStamp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewSummaryRule"
            android:layout_width="0dp"
            android:layout_height="@dimen/hairline"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/divider_rule"
            app:layout_constraintEnd_toStartOf="@+id/imgSummaryStamp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtSummaryOverline" />

        <TextView
            android:id="@+id/txtSummaryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/summary_title"
            android:textAppearance="@style/TextAppearance.App.Headline"
            app:layout_constraintEnd_toStartOf="@+id/imgSummaryStamp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewSummaryRule" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollSummary"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_xl"
            android:clipToPadding="false"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/btnSummaryAgain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtSummaryTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_l">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummaryStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/paper_raised"
                    app:cardCornerRadius="@dimen/radius_card_large"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/stroke_soft"
                    app:strokeWidth="@dimen/hairline">

                    <LinearLayout
                        android:id="@+id/gridSummaryStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <LinearLayout
                            android:id="@+id/rowSummaryTop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.tinyarchive.app.core.ui.StatCardView
                                android:id="@+id/statFiled"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_s"
                                android:layout_weight="1"
                                app:statAccent="@color/sage_primary"
                                app:statLabel="@string/stat_items_filed" />

                            <com.tinyarchive.app.core.ui.StatCardView
                                android:id="@+id/statUsed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:layout_weight="1"
                                app:statAccent="@color/terracotta_accent"
                                app:statLabel="@string/stat_categories_used" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowSummaryBottom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.tinyarchive.app.core.ui.StatCardView
                                android:id="@+id/statWritten"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_s"
                                android:layout_weight="1"
                                app:statAccent="@color/moss_success"
                                app:statLabel="@string/stat_notes_written" />

                            <com.tinyarchive.app.core.ui.StatCardView
                                android:id="@+id/statMinutes"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:layout_weight="1"
                                app:statAccent="@color/ink_secondary"
                                app:statLabel="@string/stat_minutes" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtSummaryQuiet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_quiet"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:visibility="gone" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.tinyarchive.app.core.ui.SectionHeaderView
                    android:id="@+id/headerRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    app:sectionOverline="@string/summary_recent"
                    app:sectionTitle="@string/summary_recent_title" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="none" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSummaryAgain"
            android:layout_width="0dp"
            android:layout_height="@dimen/cta_height_compact"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/summary_cta"
            app:icon="@drawable/ic_drawer_open"
            app:layout_constraintBottom_toTopOf="@+id/btnSummaryMenu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Widget.App.Button.Primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSummaryMenu"
            android:layout_width="0dp"
            android:layout_height="@dimen/cta_height_secondary"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/summary_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Widget.App.Button.Secondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
