<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/paper_raised"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="@dimen/elevation_card"
        app:strokeColor="@color/stroke_soft"
        app:strokeWidth="@dimen/hairline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/statAccentBar"
                android:layout_width="@dimen/accent_bar"
                android:layout_height="match_parent"
                android:background="@drawable/bg_accent_bar" />

            <LinearLayout
                android:id="@+id/statContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:minHeight="@dimen/stat_card_height"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="@dimen/space_s">

                <TextView
                    android:id="@+id/statValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.StatValue" />

                <TextView
                    android:id="@+id/statLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.App.Overline" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</merge>
